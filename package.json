{
  "name": "kilo-tools",
  "version": "1.0.0",
  "description": "Git-installable kilo/opencode plugin: ast-grep search/replace, context-shield, icm, rtk.",
  "main": "kilo-tools/index.ts",
  "scripts": {
    "lint:claude": "claudelint check-all",
    "lint:claude:fix": "claudelint format --fix",
    "lint:ctx": "ctxlint --strict",
    "typecheck": "tsc --noEmit",
    "lint:biome": "bunx @biomejs/biome check .",
    "lint:biome:fix": "bunx @biomejs/biome check --write .",
    "lint:oxlint": "bunx oxlint .",
    "lint:oxlint:fix": "bunx oxlint --fix .",
    "lint:oxfmt": "bunx oxfmt --check .",
    "lint:oxfmt:fix": "bunx oxfmt ."
  },
  "dependencies": {
    "@ast-grep/cli": "^0.51.1"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@opencode-ai/plugin": "^1.19.5",
    "@opencode/plugin": "2.3.0",
    "@types/bun": "^1.4.4",
    "@yawlabs/ctxlint": "^0.28.1",
    "agnix": "^0.61.0",
    "claude-code-lint": "^0.10.0",
    "mitata": "^1.0.34",
    "oxfmt": "0.78.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.1"
  }
}
